# Application
APP_URL=http://localhost:3000
DATABASE_PATH=./data/job-hunter.db
SESSION_SECRET=change-me-to-a-long-random-string

# Job sources (all three are public, keyless APIs / feeds)
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
REMOTEOK_API_URL=https://remoteok.com/api
# When a source is unreachable, fall back to saved fixtures (true/false)
SOURCE_FIXTURE_FALLBACK=true

# Optional LLM provider. Leave empty to run the deterministic,
# evidence-grounded generator (no external calls, zero hallucination risk).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Email digest (optional; in-app notifications always work)
SMTP_URL=
RESEND_API_KEY=

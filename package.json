{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted job discovery, explainable matching, truthful document tailoring and user-controlled application tracking.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run db:up && npm run dev --workspace @job-hunter/api",
    "dev:web": "npm run dev --workspace @job-hunter/web",
    "dev:worker": "npm run dev --workspace @job-hunter/worker",
    "db:up": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "seed": "tsx scripts/seed.ts",
    "build": "npm run build --workspace @job-hunter/web",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12",
    "@job-hunter/test-utils": "*"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19"
  }
}
